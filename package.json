{
  "name": "stream-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Radar \u2014 ultra media streaming detector + WatchParty + auto Indonesian subtitles, for Chrome & Firefox (Manifest V3). Not published to any store: load it unpacked.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-force-exit tools/test/core.test.mjs tools/test/integration.test.mjs tools/test/userscript.test.mjs tools/test/ui.test.mjs",
    "test:core": "node --test tools/test/core.test.mjs",
    "lint": "web-ext lint --source-dir dist/firefox --no-input --self-hosted",
    "build": "node tools/build.mjs",
    "build:chrome": "node tools/build.mjs --chrome",
    "build:firefox": "node tools/build.mjs --firefox",
    "userscript": "node tools/build-userscript.mjs",
    "demo": "node tools/serve-demo.mjs",
    "package": "node tools/build.mjs",
    "test:integration": "node --test --test-force-exit tools/test/integration.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "web-ext": "^8.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
